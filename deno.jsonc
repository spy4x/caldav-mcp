{
  "version": "0.1.0",
  "description": "Lightweight CalDAV MCP server — events + todos for AI agents",
  // Our own @spy4x/* releases resolve at once; everything else waits a day (supply-chain guard).
  "minimumDependencyAge": { "age": "1440", "exclude": ["jsr:@spy4x/*"] },
  "tasks": {
    "start": "deno run -A main.ts",
    "dev": "deno run --watch -A main.ts",
    "test": "deno test -A",
    "compile": "deno compile -A --target x86_64-unknown-linux-gnu --output caldav-mcp main.ts",
    "check": "deno lint && deno fmt --check && deno check main.ts"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true
  },
  "lint": {
    "include": ["*.ts", "caldav/**/*.ts", "tools/**/*.ts"],
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  },
  "fmt": {
    "include": ["*.ts", "caldav/**/*.ts", "tools/**/*.ts"],
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true
  },
  "imports": {
    "std/": "https://deno.land/std@0.224.0/",
    "@spy4x/caldav": "jsr:@spy4x/caldav@1.44.0",
    "@spy4x/net": "jsr:@spy4x/net@1.44.0",
    "@spy4x/platform": "jsr:@spy4x/platform@1.44.0",
    "@spy4x/server": "jsr:@spy4x/server@1.44.0",
    "@spy4x/time": "jsr:@spy4x/time@1.44.0"
  }
}
