# caldav-mcp configuration. Copy to .env and fill in; .env is never committed.
# Every value below is a placeholder.

# Required: your CalDAV server and account.
CALDAV_URL=https://cal.example.com
CALDAV_USERNAME=user
CALDAV_PASSWORD=<your-caldav-password>

# HTTP mode. HOST=0.0.0.0 inside a container; loopback otherwise.
HOST=127.0.0.1
PORT=3000
# Static token for HTTP clients such as OpenWebUI, a long random value. Setting it turns HTTP mode
# on. Left empty here so a copied file never runs with a guessable token.
MCP_BEARER_TOKEN=
# CIDR ranges of the reverse proxies in front of HTTP mode, comma separated.
TRUSTED_PROXIES=
LOG_LEVEL=info

# OAuth for claude.ai and the Claude apps. Set all three or none; see "Use it from claude.ai".
# The public origin of the server, no path. The MCP endpoint is PUBLIC_URL/mcp.
PUBLIC_URL=https://caldav-mcp.example.com
# The pbkdf2-sha256 hash of your owner password, never the password itself.
OWNER_PASSWORD_HASH=<pbkdf2-sha256-hash>
# A random secret of at least 32 characters the hash is made with.
AUTH_PEPPER=<random-secret-of-at-least-32-characters>
# Optional: the Deno KV file that keeps OAuth tokens across restarts. Its directory must exist.
OAUTH_KV_PATH=/data/oauth.kv
# Optional: with OAuth on, MCP_BEARER_TOKEN is refused unless this is true. Set it only when a
# client such as OpenWebUI still needs the static token next to OAuth.
ALLOW_BEARER_TOKEN_WITH_OAUTH=false
